# ── Normalize all text files to LF on commit ─────────────────────────────────
* text=auto eol=lf

# ── Explicitly enforce LF for source files ────────────────────────────────────
*.js        text eol=lf
*.jsx       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.css       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.sql       text eol=lf
*.env       text eol=lf
*.env.*     text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.html      text eol=lf
*.sh        text eol=lf

# ── Binary files — never touch line endings ───────────────────────────────────
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.svg       binary
*.ico       binary
*.webp      binary
*.pdf       binary
*.zip       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
